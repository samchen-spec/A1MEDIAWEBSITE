# Where form submissions are forwarded. Both are optional and independent —
# every configured destination receives the same JSON body.
#
# Payload:
# {
#   "formType": "Partner Application",
#   "name": "...", "email": "...", "phone": "...",
#   "instagram": "...", "youtube": "...", "fit": "...",
#   "receivedAt": "2026-09-02T09:41:00.000Z",
#   "source": "growingoffers.com"
# }

# Zapier / Make / n8n catch-hook URL for automations
APPLICATION_WEBHOOK_URL=

# Google Apps Script /exec URL (falls back to the existing sheet if unset)
GOOGLE_SHEETS_WEBHOOK_URL=
