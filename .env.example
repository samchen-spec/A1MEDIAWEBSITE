# Submission store. Created by connecting a Vercel Blob store to the project;
# Vercel injects these, so there is nothing to fill in by hand.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Discord: Server Settings, Integrations, Webhooks, New Webhook, Copy URL.
# Each submission posts a summary embed plus the full transcript as a .md file.
DISCORD_WEBHOOK_URL=

# Admin dashboard at /admin, the goal tracker at /goals and the Meta ads bulk
# uploader at /upload. Any string of 8+ characters; the session cookie is signed
# with a key derived from it, so changing it signs everyone out.
ADMIN_PASSWORD=

# The bulk uploader at /upload needs nothing else here. Its Meta access token is
# pasted on /upload/settings and stored in the Blob store above, not in the
# environment, so rotating it does not need a redeploy. See META-APP-SETUP.md.
